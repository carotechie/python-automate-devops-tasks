# Copia este archivo como .env y completa tus valores. .env está en .gitignore.
# Los valores de ejemplo son ficticios.

# Escenario SSO (IAM Identity Center)
SSO_START_URL=https://d-1234567890.awsapps.com/start
SSO_REGION=us-east-1

# Escenario cuenta puente: perfil de ~/.aws/config que apunta a la cuenta puente
HUB_PROFILE=hub
# ID de la cuenta destino de cada ambiente (hub_switch.py prod ReadOnly 30m)
HUB_ACCOUNTS=dev=111111111111,staging=222222222222,prod=333333333333

# Región por defecto de los perfiles generados
AWS_REGION=us-east-1

# Solo si tienes un cluster EKS (o usas otro cluster que no sea el del laboratorio).
# Reemplaza los valores vacíos por el nombre de tu cluster, por ejemplo eks-dev.
# sso_switch.py crea un contexto con ese mismo nombre, y los scripts 03, 04 y 05
# usan KUBE_CONTEXT por defecto. Si no tienes cluster, déjalos vacíos.
EKS_CLUSTER_NAME=
KUBE_CONTEXT=
