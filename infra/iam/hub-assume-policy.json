{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeOnlyReadOnlyRolesInTargets",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::222222222222:role/ReadOnly",
        "arn:aws:iam::333333333333:role/ReadOnly"
      ]
    },
    {
      "Sid": "AllowWhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
