{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowHubAccountWithMFA",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111111111111:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "NumericLessThan": {
          "aws:MultiFactorAuthAge": "43200"
        }
      }
    }
  ]
}
