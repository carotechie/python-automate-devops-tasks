# Variables para usar los scripts contra el laboratorio local.
# Uso: source lab/lab.env
# Credenciales ficticias: LocalStack acepta cualquier valor.
export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=us-east-1
export AWS_REGION=us-east-1
# Fija los scripts de Kubernetes al cluster del laboratorio, aunque tengas otros contextos.
export KUBE_CONTEXT=kind-pyladies-lab
